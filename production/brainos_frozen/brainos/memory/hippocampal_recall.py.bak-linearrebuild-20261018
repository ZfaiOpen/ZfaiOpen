_TKG_OBJ_STOP = "gonna going just still really so very not no also too always never trying excited sorry happy glad sure okay fine here there awesome great good tough hard bumpy determined now currently lately today".split()
_TKG_SUBJ_STOP = "what that this it he she they you we who which there one everyone nobody anybody anyone".split(); _TKG_W0_STOP = "to been being for with that because at on of about".split()
_TKG_OBJ_PRON = "my our mine ours myself yourself you yours".split()
_TKG_CLAUSE = r"(?=\s*[.,;!?\n]|\s+(?:and|but|so|because|when|while|since|after|before|though|which|who|that)\b|$)"
_TKG_SUB_EN = r"([A-Z][a-z]+(?:\s[A-Z][a-z]+)?)"; _TKG_OBJ_EN = r"((?:an?|the|my|our|your|his|her|their|two|three|four)?\s*[A-Za-z][A-Za-z \-]{2,44}?)"
_TKG_CN_SUB = r"([\u4e00-\u9fff]{1,6}?|我)"; _TKG_CN_TEM = r"(?:现在|目前|如今)?"
_TKG_PATS = [
    ("is",     re.compile(r"\b" + _TKG_SUB_EN + r"\s+(?:is|was)\s+" + _TKG_OBJ_EN + _TKG_CLAUSE, re.M)),
    ("is",     re.compile(r"\b(I)(?:'m| am| was)\s+" + _TKG_OBJ_EN + _TKG_CLAUSE)),
    ("works",  re.compile(r"\b" + _TKG_SUB_EN + r"\s+works?\s+(?:as|at|for|on)\s+" + _TKG_OBJ_EN + _TKG_CLAUSE)),
    ("works",  re.compile(r"\b(I)\s+(?:work|worked)\s+(?:as|at|for|on)\s+" + _TKG_OBJ_EN + _TKG_CLAUSE)),
    ("has",    re.compile(r"\b" + _TKG_SUB_EN + r"\s+has\s+" + _TKG_OBJ_EN + _TKG_CLAUSE)),
    ("has",    re.compile(r"\b(I)\s+(?:have|had)\s+" + _TKG_OBJ_EN + _TKG_CLAUSE)),
    ("is",     re.compile(_TKG_CN_SUB + _TKG_CN_TEM + r"是([^，。！？；\n]{2,24}?)(?=[，。！？；\n]|而且|但是|因为|所以|然后|$)")),
    ("has",    re.compile(_TKG_CN_SUB + _TKG_CN_TEM + r"有([^，。！？；\n]{2,24}?)(?=[，。！？；\n]|而且|但是|因为|所以|然后|$)")),
    ("works",  re.compile(_TKG_CN_SUB + _TKG_CN_TEM + r"在([^，。！？；\n]{1,20}?)(?:工作|任职|上班)")),
]

def _tkg_clean_obj(s: str) -> str:
    s = re.sub(r"\s+", " ", re.sub(r"^(?:an?|the|my|our|your|his|her|their|some|really|just|still)\s+",
               "", (s or "").strip(), flags=re.I)).strip(" .,;:!?-—'\"")
    low = s.lower()
    if any(low == st or low.startswith(st + " ") for st in _TKG_OBJ_STOP):
        return ""  # 噪声前缀(寒暄/副词开头非事实值)→弃
    if low.endswith((" now", " lately", " today", " anymore")):
        s = s.rsplit(" ", 1)[0].strip()
    return s if 2 < len(s) <= 60 else ""
def _tkg_extract(text: str, speaker: str) -> list[tuple[str, str, str]]:
    """纯正则三元组抽取: (主语,谓语,值)·每卡≤3·零LLM·抽不出跳过"""
    out: list[tuple[str, str, str]] = []
    try:
        for pred, pat in _TKG_PATS:
            for m in pat.finditer(text or ""):
                sub = (m.group(1) or "").strip()
                obj = _tkg_clean_obj(m.group(2) or "")
                if sub.lower() in ("i", "me", "my", "我"):
                    sub = (speaker or "").strip()
                ws = obj.lower().split()
                if (not obj or not sub or len(sub) > 40 or sub.lower() in _TKG_SUBJ_STOP
                        or (ws and ((ws[0].endswith(("ing", "ed"))
                                     and ws[0] not in ("based", "located"))
                                    or ws[0] in _TKG_W0_STOP))
                        or (sub.lower() != (speaker or "").strip().lower()
                            and any(t in _TKG_OBJ_PRON for t in ws))):
                    continue  # 代词主语/动词性值开头/他主体带一二人物代词→噪声弃
                if any(a.lower() == sub.lower() and b == pred for a, b, _ in out):
                    continue  # 同卡同(主,谓)只留首条
                out.append((sub, pred, obj))
                if len(out) >= 3:
                    return out
    except Exception:
        return out  # fail-soft: 抽取异常按零命中处理
    return out


_TKG_QUERY_SIG = re.compile(r"\b(?:current(?:ly)?|these\s+days|now|nowadays|lately|at\s+present|today|still)\b|现在|目前|如今|当前|最近|近来", re.I)


def _tkg_subj_in_query(subj: str, query: str) -> bool:
    if re.fullmatch(r"[\u4e00-\u9fff]+", subj):
        return subj in query
    return re.search(r"(?<![A-Za-z0-9])" + re.escape(subj) + r"(?![A-Za-z0-9])", query, re.I) is not None


